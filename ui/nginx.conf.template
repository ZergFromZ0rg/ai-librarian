server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 100m;

    location /api/ {
        proxy_pass http://document-service:8000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Empty unless APP_TOKEN is set, in which case it is "Bearer <token>";
        # an empty value means the header is not forwarded.
        proxy_set_header Authorization "${APP_TOKEN_HEADER}";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        # Ask mode answers stream as Server-Sent Events; without this nginx
        # buffers the whole response and the answer lands in one lump.
        proxy_buffering off;
    }

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
