# Bind to 127.0.0.1 for access through SSH or a reverse proxy.
# Set 0.0.0.0 only when the server is on a trusted network.
BIND_ADDRESS=127.0.0.1
UI_PORT=3100
API_PORT=8000

# When set, the document-service API requires "Authorization: Bearer <APP_TOKEN>"
# on every request except the health checks. The bundled UI keeps working (nginx
# forwards the token). Leave empty for a loopback / SSH-tunnel deployment.
# Exposing the UI to an untrusted network still needs a real auth proxy in front.
APP_TOKEN=

# Log verbosity for the document service (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Per-query diagnostics at data/app/logs/search.jsonl (rotated, never leaves the
# server). Set to off to disable.
SEARCH_LOG=on

# Allow the service to discard and rebuild the Qdrant collection when the
# embedding model's vector size changes. Off by default so a stray EMBEDDING_MODEL
# edit cannot silently wipe the index; set to 1 for a deliberate model switch.
ALLOW_INDEX_RESET=0

# Bake the embedding + reranker models into the image at build time (adds
# ~400 MB) so a fully offline host can run without ever downloading them.
PREBAKE_MODELS=0
# Forbid the huggingface libraries from reaching the network. Set to 1 on an
# air-gapped host once the models are cached (prebaked image or warm_models.py).
OFFLINE=0

MAX_UPLOAD_MB=100
EMBEDDING_BATCH_SIZE=32

# Sentence-embedding model for semantic search. bge-base-en-v1.5 is a 768-dim,
# 512-token model that wants an instruction prefix on the query only. Prefixes
# include a trailing space and must be quoted here. For e5-* use "query: " /
# "passage: "; for an unprefixed model (all-MiniLM-L6-v2) set both to "".
# Changing the model re-embeds the whole library on next start; if the new model
# has a different dimension you also need ALLOW_INDEX_RESET=1 once.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
EMBEDDING_PASSAGE_PREFIX=""
# Matryoshka models only: keep the first N dimensions (0 = model's native width).
EMBEDDING_DIMS=0

# BM25 knobs for the keyword half of search. k1 sets how fast repeated words
# stop helping; b sets how much long passages are penalised; avgdl is the
# reference passage length in weighted terms (chunks are token-budgeted, so a
# fixed value tracks the corpus average). Rare-word weighting (IDF) is automatic.
LEXICAL_K1=1.5
LEXICAL_B=0.75
LEXICAL_AVGDL=180

# How the semantic and lexical result lists are merged:
#   rrf  - by rank position only (robust default)
#   dbsf - Qdrant normalises each score list by mean/stdev, then sums
#   rsf  - min-max each list to 0..1, then FUSION_DENSE_WEIGHT*dense + rest*sparse
# A search request may override both. Query-time only, no re-index.
FUSION_METHOD=rrf
FUSION_DENSE_WEIGHT=0.5

# Cross-encoder that re-sorts the shortlist. ms-marco-MiniLM-L-6-v2 (~90 MB) is
# tiny and fast (~1 s for 60 candidates on CPU). BAAI/bge-reranker-base (~1.1 GB)
# is stronger on scholarly prose but ~15x slower on CPU and, on the reference
# library, saturates its score and occasionally rates unrelated text above 0.9 --
# with a strong dense model (bge-base) the extra cost did not pay off. After
# changing it, re-check RERANK_MIN_SCORE / RERANK_LOWCONF_SCORE against the score
# scale (MiniLM: logits around 0; bge: 0..1 probability).
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# What the reranker scores: "group" = the whole parent passage (default),
# "matched" = just the retrieval unit that won the search. "group" gives the
# reranker context to separate near-duplicate passages; "matched" saturates a
# 0..1 model's score on short fragments and bare headings.
RERANK_PASSAGE=group
RERANK_TIMEOUT=15
# How many fused (dense+sparse) candidates the cross-encoder actually scores per
# query. Fusion is a coarse filter; the reranker picks the winning passage, so it
# needs a wide pool. Cheap at 60 with MiniLM; with a heavy RERANK_MODEL this is
# the main latency knob -- drop it to ~25 there.
RERANK_CANDIDATES=60
# Hard floor on the reranker score: hits below it are dropped so an unanswerable
# query returns empty. -2.0 works with the default MiniLM (every off-topic probe
# scores below -3.5, real answers above -2). bge-reranker-base cannot be gated
# (it scored 0.93 for "chess en passant"). Re-fit with `eval/harness.py
# calibrate` after changing RERANK_MODEL; "off" disables. Only with rerank=true.
RERANK_MIN_SCORE=-2.0
# Soft version of the above: when the top reranked hit scores below this the
# response is flagged and the UI shows a "nothing clearly matched" banner without
# hiding results. 0.0 suits MiniLM logits; raise (~0.3) for a 0..1 model; "off"
# disables the flag.
RERANK_LOWCONF_SCORE=0.0
CHUNK_TARGET_TOKENS=180
CHUNK_SOFT_MAX_TOKENS=220
CHUNK_HARD_MAX_TOKENS=240
CHUNK_OVERLAP_TOKENS=32

# --- Ask mode (LLM answers over the retrieved passages) --------------------
# The reader picks a model per conversation in the Ask tab. Models come from:
#   - your local Ollama (free, offline) — discovered automatically
#   - a cloud API — shown only when its key is set below
# Ask mode is enabled whenever at least one model is available. If nothing is
# configured, the UI shows Search only.
#
# Ollama on the Docker host. It must listen on 0.0.0.0 (set OLLAMA_HOST=0.0.0.0
# in Ollama's systemd override) — the default 127.0.0.1 bind is unreachable from
# the container. Set OLLAMA_URL empty to disable Ollama discovery entirely.
OLLAMA_URL=http://host.docker.internal:11434
#
# Cloud providers — leave a key blank to hide that provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
#
# Optional "provider:model" default before the reader picks (e.g.
# ollama:llama3.2:latest or anthropic:claude-opus-5). Empty = first available.
GENERATION_MODEL=
# Optional comma-separated overrides of the cloud model choices in the picker.
ANTHROPIC_MODELS=
OPENAI_MODELS=
GOOGLE_MODELS=
#
# Shared: answer length ceiling, sampling temperature, request timeout (s), and
# how much retrieved context to put in front of the model.
GENERATION_MAX_TOKENS=2000
GENERATION_TEMPERATURE=0.2
GENERATION_TIMEOUT=120
ASK_CONTEXT_PASSAGES=10
ASK_MAX_CONTEXT_CHARS=10000

# Only needed for direct cross-origin API development. The container UI uses
# a same-origin reverse proxy and does not require CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
