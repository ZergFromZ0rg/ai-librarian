# Bind to 127.0.0.1 for access through SSH or a reverse proxy.
# Set 0.0.0.0 only when the server is on a trusted network.
BIND_ADDRESS=127.0.0.1
UI_PORT=3100
API_PORT=8000

# When set, the document-service API requires "Authorization: Bearer <APP_TOKEN>"
# on every request except the health checks. The bundled UI keeps working (nginx
# forwards the token). Leave empty for a loopback / SSH-tunnel deployment.
# Exposing the UI to an untrusted network still needs a real auth proxy in front.
APP_TOKEN=

# Log verbosity for the document service (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Per-query diagnostics at data/app/logs/search.jsonl (rotated, never leaves the
# server). Set to off to disable.
SEARCH_LOG=on

# Allow the service to discard and rebuild the Qdrant collection when the
# embedding model's vector size changes. Off by default so a stray EMBEDDING_MODEL
# edit cannot silently wipe the index; set to 1 for a deliberate model switch.
ALLOW_INDEX_RESET=0

# Bake the embedding + reranker models into the image at build time (adds
# ~400 MB) so a fully offline host can run without ever downloading them.
PREBAKE_MODELS=0
# Forbid the huggingface libraries from reaching the network. Set to 1 on an
# air-gapped host once the models are cached (prebaked image or warm_models.py).
OFFLINE=0

MAX_UPLOAD_MB=100
EMBEDDING_BATCH_SIZE=32

# Sentence-embedding model for semantic search. e5-small-v2 is a 384-dim,
# 512-token model that expects each input labelled by role. The prefixes include
# a trailing space and must be quoted here. To go back to the older
# sentence-transformers/all-MiniLM-L6-v2, set that as EMBEDDING_MODEL and both
# prefixes to "". Changing the model re-embeds the whole library on next start.
EMBEDDING_MODEL=intfloat/e5-small-v2
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "
# Matryoshka models only: keep the first N dimensions (0 = model's native width).
EMBEDDING_DIMS=0

# How the semantic and lexical result lists are merged:
#   rrf  - by rank position only (robust default)
#   dbsf - Qdrant normalises each score list by mean/stdev, then sums
#   rsf  - min-max each list to 0..1, then FUSION_DENSE_WEIGHT*dense + rest*sparse
# A search request may override both. Query-time only, no re-index.
FUSION_METHOD=rrf
FUSION_DENSE_WEIGHT=0.5

RERANK_TIMEOUT=15
# How many fused (dense+sparse) candidates the cross-encoder actually scores per
# query. Fusion is a coarse filter; the reranker picks the winning passage, so it
# needs a wide pool. Higher = better recall, ~linearly more latency (~1s at 60 on
# a CPU host). A request's rerank_k acts as a floor on top of this.
RERANK_CANDIDATES=60
# Drop reranked hits scoring below this (cross-encoder logit). Keeps a query with
# no real answer in the library from returning unrelated chunks. Only applies when
# a search sets rerank=true. Set to "off" to disable the gate.
RERANK_MIN_SCORE=0.0
CHUNK_TARGET_TOKENS=180
CHUNK_SOFT_MAX_TOKENS=220
CHUNK_HARD_MAX_TOKENS=240
CHUNK_OVERLAP_TOKENS=32

# Only needed for direct cross-origin API development. The container UI uses
# a same-origin reverse proxy and does not require CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
