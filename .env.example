# Bind to 127.0.0.1 for access through SSH or a reverse proxy.
# Set 0.0.0.0 only when the server is on a trusted network.
BIND_ADDRESS=127.0.0.1
UI_PORT=3100
API_PORT=8000

# When set, the document-service API requires "Authorization: Bearer <APP_TOKEN>"
# on every request except the health checks. The bundled UI keeps working (nginx
# forwards the token). Leave empty for a loopback / SSH-tunnel deployment.
# Exposing the UI to an untrusted network still needs a real auth proxy in front.
APP_TOKEN=

# Log verbosity for the document service (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Per-query diagnostics at data/app/logs/search.jsonl (rotated, never leaves the
# server). Set to off to disable.
SEARCH_LOG=on

# Allow the service to discard and rebuild the Qdrant collection when the
# embedding model's vector size changes. Off by default so a stray EMBEDDING_MODEL
# edit cannot silently wipe the index; set to 1 for a deliberate model switch.
ALLOW_INDEX_RESET=0

MAX_UPLOAD_MB=100
EMBEDDING_BATCH_SIZE=32
RERANK_TIMEOUT=15
CHUNK_TARGET_TOKENS=180
CHUNK_SOFT_MAX_TOKENS=220
CHUNK_HARD_MAX_TOKENS=240
CHUNK_OVERLAP_TOKENS=32

# Only needed for direct cross-origin API development. The container UI uses
# a same-origin reverse proxy and does not require CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
